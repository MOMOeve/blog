# docker compose 可选覆盖（复制为 .env 后修改）
WEB_PORT=8080
SECRET_KEY=django-insecure-docker-dev-change-me
MYSQL_DATABASE=hoshino_blog
MYSQL_USER=blog
MYSQL_PASSWORD=blogpass
MYSQL_ROOT_PASSWORD=rootpass
ALLOWED_HOSTS=*
