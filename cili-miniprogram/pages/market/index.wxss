.loc-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--cili-green-bg);
  color: var(--cili-green);
  padding: 20rpx 24rpx;
  border-radius: var(--cili-radius);
  margin-bottom: 28rpx;
  font-size: 26rpx;
}

.loc-bar .arrow {
  margin-left: auto;
  color: var(--cili-muted);
}

.upload-card {
  background: #fff;
  border: 2rpx dashed #B7CEC2;
  border-radius: var(--cili-radius-lg);
  padding: 24rpx;
  margin-bottom: 32rpx;
}

.upload-preview,
.upload-placeholder {
  height: 280rpx;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  background: linear-gradient(160deg, #EAF3EC, #D8EADF);
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.fruit-illus {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #C5DFD0;
  color: var(--cili-green);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
}

.upload-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  text-align: center;
}

.upload-icon {
  color: var(--cili-green-mid);
  font-size: 32rpx;
}

.upload-main {
  font-size: 26rpx;
  color: var(--cili-text);
}

.result-title {
  margin-top: 8rpx;
}

.result-row {
  display: flex;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.result-card {
  flex: 1;
  background: var(--cili-green-bg);
  border-radius: 24rpx;
  padding: 24rpx 20rpx;
}

.result-label {
  font-size: 24rpx;
  color: var(--cili-text-secondary);
  margin-bottom: 8rpx;
}

.result-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--cili-green);
  margin-bottom: 10rpx;
}

.result-sub {
  font-size: 22rpx;
  color: var(--cili-text-secondary);
  line-height: 1.5;
}

.action-row {
  display: flex;
  gap: 18rpx;
  margin-bottom: 36rpx;
}

.action-btn {
  flex: 1;
}

.quotes-card {
  margin-bottom: 24rpx;
}

.refresh {
  font-size: 22rpx;
}

.quote-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--cili-border);
  gap: 12rpx;
}

.quote-item:last-of-type {
  border-bottom: none;
}

.q-name {
  flex: 1.2;
  font-size: 26rpx;
  color: var(--cili-text);
}

.q-price {
  flex: 1;
  font-size: 26rpx;
  color: var(--cili-green);
  font-weight: 600;
  text-align: right;
}

.q-trend {
  width: 120rpx;
  text-align: right;
  font-size: 24rpx;
  font-weight: 500;
}

.q-trend.up {
  color: var(--cili-green-mid);
}

.q-trend.down {
  color: var(--cili-danger);
}

.q-trend.flat {
  color: var(--cili-muted);
}

.more {
  text-align: center;
  padding-top: 12rpx;
}
