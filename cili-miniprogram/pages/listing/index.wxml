<view class="page">
  <view class="card">
    <view class="section-title"><text class="dot"></text><text>挂售信息</text></view>
    <view class="field">
      <text class="label">等级</text>
      <input class="input" value="{{grade}}" bindinput="onGrade" />
    </view>
    <view class="field">
      <text class="label">售价（元/{{unit}}）</text>
      <input class="input" type="digit" value="{{price}}" bindinput="onPrice" />
    </view>
    <view class="field">
      <text class="label">数量（{{unit}}）</text>
      <input class="input" type="number" value="{{quantity}}" bindinput="onQty" />
    </view>
    <view class="field">
      <text class="label">产地</text>
      <text class="value">{{locationLabel}}</text>
    </view>
  </view>
  <button class="btn-primary" bindtap="onSubmit" loading="{{loading}}">发布挂售</button>
  <view class="api-note muted">接口：POST /v1/listing/create</view>
</view>
