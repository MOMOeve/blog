.profile {
  padding-top: 0;
}

.hero {
  margin: -24rpx -32rpx 28rpx;
  padding: 48rpx 32rpx 36rpx;
  background: linear-gradient(165deg, #D8EADF 0%, #EAF3EC 45%, #F4F8F3 100%);
  position: relative;
}

.settings-btn {
  position: absolute;
  top: 24rpx;
  right: 32rpx;
  font-size: 36rpx;
  color: var(--cili-green);
  padding: 8rpx;
}

.user-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #74A892, #2D6A4F);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  border: 4rpx solid #fff;
}

.uname {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--cili-green);
  margin-bottom: 6rpx;
}

.badge-leaf {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--cili-green-mid);
  color: #fff;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.role-switch {
  display: flex;
  background: rgba(255, 255, 255, 0.75);
  border-radius: 999rpx;
  padding: 6rpx;
  border: 1rpx solid var(--cili-border);
}

.role {
  flex: 1;
  text-align: center;
  padding: 16rpx 8rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--cili-text-secondary);
}

.role.on {
  background: var(--cili-green);
  color: #fff;
  font-weight: 600;
}

.order-card,
.menu-card {
  margin-bottom: 24rpx;
}

.block-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--cili-text);
}

.order-status {
  display: flex;
  margin-top: 28rpx;
}

.st {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: var(--cili-text-secondary);
}

.st-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--cili-green-bg);
  color: var(--cili-green);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--cili-border);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: var(--cili-green-bg);
  color: var(--cili-green);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--cili-text);
}

.badge {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: var(--cili-green-mid);
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
}

.chev {
  color: var(--cili-muted);
  font-size: 36rpx;
}
