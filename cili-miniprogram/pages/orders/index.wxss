.tabs {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.tab {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #fff;
  color: var(--cili-text-secondary);
  font-size: 26rpx;
  border: 1rpx solid var(--cili-border);
}

.tab.on {
  background: var(--cili-green);
  color: #fff;
  border-color: var(--cili-green);
}

.order {
  margin-bottom: 20rpx;
}

.oid {
  font-size: 24rpx;
  color: var(--cili-muted);
}

.status {
  color: var(--cili-green);
  font-weight: 600;
  font-size: 26rpx;
}

.pname {
  font-size: 30rpx;
  font-weight: 600;
  margin: 16rpx 0 12rpx;
}

.amount {
  color: var(--cili-green);
  font-weight: 700;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
}
