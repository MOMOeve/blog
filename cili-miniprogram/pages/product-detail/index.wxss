.hero-thumb {
  height: 360rpx;
  border-radius: var(--cili-radius-lg);
  background: linear-gradient(160deg, #EAF3EC, #C5DFD0);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--cili-green);
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.card {
  margin-bottom: 24rpx;
}

.name {
  font-size: 36rpx;
  font-weight: 700;
}

.spec {
  margin: 8rpx 0 16rpx;
}

.price {
  color: var(--cili-green);
  font-size: 40rpx;
  font-weight: 700;
}

.origin {
  margin-left: 12rpx;
  color: var(--cili-muted);
  text-decoration: line-through;
}

.desc,
.body {
  margin-top: 12rpx;
  color: var(--cili-text-secondary);
  line-height: 1.65;
}

.cmp {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--cili-border);
}

.cmp:last-child {
  border-bottom: none;
}

.cmp-price {
  color: var(--cili-green);
  font-weight: 600;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 32rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(45, 106, 79, 0.08);
}

.half {
  flex: 1;
}

.page {
  padding-bottom: 160rpx;
}
