.msg {
  display: flex;
  gap: 20rpx;
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--cili-green-bg);
  color: var(--cili-green);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  flex-shrink: 0;
}

.body {
  flex: 1;
  min-width: 0;
}

.from {
  font-weight: 600;
  font-size: 28rpx;
}

.preview {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  gap: 12rpx;
}

.preview text {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
}

.unread {
  color: var(--cili-text);
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--cili-green-mid);
  flex-shrink: 0;
}
