.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--cili-green-bg);
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
  margin-bottom: 24rpx;
}

.search-icon {
  color: var(--cili-muted);
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--cili-text);
}

.ph {
  color: var(--cili-muted);
}

.cats {
  display: flex;
  gap: 14rpx;
  margin-bottom: 28rpx;
}

.cat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 18rpx 8rpx;
  background: #fff;
  border: 2rpx solid var(--cili-border);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: var(--cili-green);
}

.cat.active {
  background: var(--cili-green-bg);
  border-color: var(--cili-green-mid);
  font-weight: 600;
}

.cat-icon {
  font-size: 28rpx;
}

.banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(120deg, #D8EADF 0%, #EAF3EC 55%, #C5DFD0 100%);
  border-radius: var(--cili-radius-lg);
  padding: 32rpx 28rpx;
  margin-bottom: 32rpx;
  min-height: 180rpx;
}

.banner-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--cili-green);
  margin-bottom: 8rpx;
}

.banner-sub {
  font-size: 24rpx;
  color: var(--cili-text-secondary);
  margin-bottom: 18rpx;
}

.banner-cta {
  display: inline-flex;
  padding: 8rpx 20rpx;
  background: var(--cili-green);
  color: #fff;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.banner-art {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(45, 106, 79, 0.12);
  color: var(--cili-green);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
}

.section-head {
  margin-bottom: 20rpx;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.product-card {
  width: calc(50% - 9rpx);
  background: #fff;
  border-radius: 24rpx;
  padding: 20rpx;
  position: relative;
  box-shadow: 0 6rpx 18rpx rgba(45, 106, 79, 0.05);
}

.badge {
  position: absolute;
  top: 0;
  right: 0;
  background: var(--cili-green-mid);
  color: #fff;
  font-size: 18rpx;
  padding: 6rpx 12rpx;
  border-radius: 0 24rpx 0 16rpx;
}

.thumb {
  height: 160rpx;
  border-radius: 16rpx;
  background: linear-gradient(160deg, #EAF3EC, #D8EADF);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--cili-green-soft);
  font-size: 26rpx;
  margin-bottom: 14rpx;
}

.pname {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--cili-text);
}

.pspec {
  margin: 4rpx 0 12rpx;
}

.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.price {
  color: var(--cili-green);
  font-size: 30rpx;
  font-weight: 700;
}

.origin {
  margin-left: 8rpx;
  color: var(--cili-muted);
  font-size: 22rpx;
  text-decoration: line-through;
}

.cart-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 2rpx solid var(--cili-green-mid);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}
